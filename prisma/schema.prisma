generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id         String     @id                            
  username   String?
  balance    Int        @default(0)
  imageUri   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  payments   Payment[]
  orders     Order[]
}

model Payment {
  id         String         @id @default(cuid())      
  userId     String
  orderId    String  @unique
  amount     Int       
  status     PaymentStatus  @default(PENDING)
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id])
  order      Order          @relation(name: "OrderToPayment", fields: [orderId], references: [id])
}

model Order {
  id            String       @id @default(cuid())
  userId        String
  tx_ref        String       @unique
 serviceId     Int
  
  targetUrl     String
  amount        Decimal      @db.Decimal(10, 2)
  status        OrderStatus  @default(PENDING)
  paidAt        DateTime?
 
  reference     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id])
   service       SmmService   @relation(fields: [serviceId], references: [id])

  payment       Payment?     @relation("OrderToPayment")
}
model SmmService {
  id         Int     @id @default(autoincrement())
  serviceId  Int     @unique // JAP's ID
  name       String
  type       String
  category   String
  rate       Float
  min        Int
  max        Int
  
  refill     Boolean @default(false)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
    orders     Order[] 
}
